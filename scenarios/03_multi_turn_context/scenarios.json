      "severity": "high",
      "observability_hints": {
        "expected_spans": 4,
        "key_attributes": [
          "orchestration.turn_count",
          "orchestration.context_retained",
          "orchestration.context_field_delta"
        ]
      },
      "latency_budget_ms": 3000
    },
