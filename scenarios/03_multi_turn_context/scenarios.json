    {
      "id": "MTX-001",
      "category": "multi_turn_context",
      "subcategory": "context_carryover",
      "domain": "manufacturing",
      "title": "Plant context retained across turns",
      "prompt": null,
      "turns": [
        {
          "turn": 1,
          "user": "I'm working at Plant 3.",
          "expected_state": {
            "plant": "Plant 3"
          }
        },
        {
          "turn": 2,
          "user": "Check the status of line 2.",
          "expected_state": {
            "plant": "Plant 3",
            "line": "2",
            "action": "line_status_check"
          }
        }
      ],
      "expected_routing": {
        "agents": [
          "ContextManagerAgent",
          "ManufacturingMESAgent"
        ],
        "pattern": "sequential",
        "notes": "Turn 2 must use Plant 3 from turn 1. Querying line 2 at Plant 3, not a default or unknown plant."
      },
      "expected_clarification": [],
      "failure_modes": [
        "Checks line 2 without specifying Plant 3 \u2014 returns wrong line",
        "Asks 'which plant?' on turn 2 \u2014 context was already provided",
        "Checks line 2 at default plant (Plant 1)"
      ],
      "enterprise_impact": "Wrong production line monitored; undetected stoppage at actual plant.",
      "scoring": {
        "context_retained": 60,
        "correct_routing": 40
      },
      "tags": [
        "multi-turn",
        "context-carryover",
        "manufacturing",
        "plant",
        "P1"
