  "scenarios": [
    {
      "id": "CLR-001",
      "category": "clarification_required",
      "subcategory": "missing_identifier",
      "domain": "hr",
      "title": "HR: Missing employee ID for leave request",
      "prompt": "I need to submit a leave request.",
      "turns": null,
      "expected_routing": {
        "agents": [
          "HRTriageAgent",
          "ClarificationAgent",
          "LeaveRequestAgent"
        ],
        "pattern": "sequential",
        "notes": "Triage identifies missing context; ClarificationAgent collects required fields; LeaveRequestAgent submits."
      },
      "expected_clarification": [
        "Employee ID",
        "Leave type (vacation/sick/personal)",
        "Start and end dates",
        "Manager name for approval routing"
      ],
      "failure_modes": [
        "Creates a blank leave request without required fields",
        "Asks only for dates but not employee ID",
        "Routes directly to LeaveRequestAgent with incomplete data"
      ],
      "enterprise_impact": "Leave request rejected or routed to wrong approver; HR compliance gap.",
      "scoring": {
        "clarification_completeness": 70,
        "no_premature_action": 30
      },
      "tags": [
        "clarification",
        "hr",
        "leave",
        "missing-entity",
        "P1"
      ],
      "severity": "high",
      "observability_hints": {
        "expected_spans": 4,
        "key_attributes": [
          "orchestration.clarification_required",
          "orchestration.missing_fields",
